pico-8 cartridge // http://www.pico-8.com
version 42
__lua__

#include ../rayc.lua
#include ../../math.lua

pos = Vect({x = 64, y = 64})

speed = 48
padd = 4
dt = 1 / 60

function _update60()

    control()
end

function _draw()

    cls(3)
    map(0, 0, 0, 0, 16, 16)

    xd = 32

    positiveXray()
    negativeXray()
    positiveYray()
    negativeYray()

    spr(1, pos.x - 4, pos.y - 4)
end


function control()

    if btn(0) then pos.x -= speed * dt end
    if btn(1) then pos.x += speed * dt end
    if btn(2) then pos.y -= speed * dt end
    if btn(3) then pos.y += speed * dt end
end

function isSolid(x, y)

    return mget(flr(x / 8), flr(y / 8)) == 2
end

function positiveXray()

    local r1 = rayc({initPosi = pos.x, dist = xd, isSolid = function(i) return isSolidx(i, -1) end})
    local r2 = rayc({initPosi = pos.x, dist = xd, isSolid = function(i) return isSolidx(i,  1) end})
    rectfill(pos.x + 3, pos.y - padd, min(r1.posi, r2.posi), pos.y + padd - 1, rayColor(r1, r2))
    rectfill(pos.x + 3, pos.y - padd, min(r1.posi, r2.posi), pos.y + padd - 1, rayColor(r1, r2))
end

function negativeXray()

    local r1 = rayc({initPosi = pos.x, dist =-xd, isSolid = function(i) return isSolidx(i, -1) end})
    local r2 = rayc({initPosi = pos.x, dist =-xd, isSolid = function(i) return isSolidx(i,  1) end})
    rectfill(pos.x - 4, pos.y - padd, max(r1.posi, r2.posi), pos.y + padd - 1, rayColor(r1, r2))
    rectfill(pos.x - 4, pos.y - padd, max(r1.posi, r2.posi), pos.y + padd - 1, rayColor(r1, r2))
end

function isSolidx(i, sgn)

    return isSolid(i, pos.y + padd * sgn)
end


function positiveYray()

    local r1 = rayc({initPosi = pos.y, dist = xd, isSolid = function(i) return isSolidy(i, -1) end})
    local r2 = rayc({initPosi = pos.y, dist = xd, isSolid = function(i) return isSolidy(i,  1) end})
    rectfill(pos.x - padd, pos.y + 3, pos.x + padd - 1, min(r1.posi, r2.posi), rayColor(r1, r2))
    rectfill(pos.x - padd, pos.y + 3, pos.x + padd - 1, min(r1.posi, r2.posi), rayColor(r1, r2))
end

function negativeYray()

    local r1 = rayc({initPosi = pos.y, dist =-xd, isSolid = function(i) return isSolidy(i, -1) end})
    local r2 = rayc({initPosi = pos.y, dist =-xd, isSolid = function(i) return isSolidy(i,  1) end})
    rectfill(pos.x - padd, pos.y - 4, pos.x + padd - 1, max(r1.posi, r2.posi), rayColor(r1, r2))
    rectfill(pos.x - padd, pos.y - 4, pos.x + padd - 1, max(r1.posi, r2.posi), rayColor(r1, r2))
end

function isSolidy(i, sgn)

    return isSolid(pos.x + padd * sgn, i)
end

function rayColor(r1, r2)

    return (r1.coll or r2.coll) and 8 or 12
end

