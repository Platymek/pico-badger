pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
#include ../../math.lua
#include ../jump.lua

initial = Vect({

    x = 64,
    y = 64 * 1.5,
})

jump = JumpProp({

    timeToPeak = 0.5,
    timeToFall = 0.4,
    maxHeight = 48,
    minHeight = 8,
})

vect = Vect(initial)
velo = 0
dt = 1 / 60
height = initial.y
unit = 16

function _update60()

    if vect.y == initial.y then

        if btn(4) or btn(5) or btn(2) then

            velo = -jump.jumpVelo
            height = initial.y
        end
    else
        velo = jump:fall({ currVelo = velo, dt = dt })
        
        if not (btn(4) or btn(5) or btn(2)) and velo < -jump.minVelo then velo = -jump.minVelo end
    end

    if height > vect.y then height = vect.y end
    vect.y += velo * dt
    
    if vect.y > initial.y then

        vect.y = initial.y
        velo = 0
    end
end

function _draw()

    cls(12)
    spr(1, vect.x, vect.y)
    print("jump velocity: " .. jump.jumpVelo, 4, 4, 1)
    print("jump min velocity: " .. jump.minVelo)
    print("velocity: " .. velo)
    print("height: " .. (initial.y - height))
    print("gravity: " .. (velo > 0 and jump.fallGrav or jump.jumpGrav))
    print("y: " .. vect.y)
end
__gfx__
