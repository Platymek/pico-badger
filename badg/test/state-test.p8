pico-8 cartridge // http://www.pico-8.com
version 42
__lua__

#include ../state.lua

state = {}
staminaMax = 4
stamina = staminaMax
x = 64
y = 64


can = {}

function can.run()

    if  (btn(4) or btn(5)) 
        and stamina == staminaMax then
        return states.run end
end

function can.walk()

    if  not (btn(4) or btn(5))
        or stamina <= 0 then
        return states.walk end
end


is = {}

function is.moving(p)
    if (btn(0) and btn(1)) or not (btn(0) or btn(1)) then
        return end
    x += state.spd * p.dt * (btn(0) and -1 or 1)
end

function is.recovering(p)

    if stamina < staminaMax then
        stamina = min(staminaMax, stamina + p.dt) end
end

function is.draining(p)

    if stamina > 0 then
        stamina = max(0, stamina - p.dt) end
end


states = {}

states.def = State{

    props = {

        spd = 16,
        color = 11
    },

    is = {

        is.moving
    }
}

states.walk = State{

    can = {

        can.run
    },

    is = {

        is.recovering
    }
}

states.run = State{

    can = {

        can.walk
    },

    is = {

        is.draining
    },

    props = {

        spd = 32,
        color = 8
    } 
}

state = StateMachine{default = states.def, current = states.walk}
dt = 1/60

state.isIn(states.walk)

function _update60()

    state({ dt = dt })
end

function _draw()

    cls(1)
    rect(x - 8, y - 8, x + 8, y + 8, state.color)

    local s = stamina / staminaMax * 16
    local halfS = s / 2
    rectfill(x - halfS, y + 16, x + halfS, y + 20, state.isIn(states.run) and 8 or stamina < staminaMax and 9 or 11)
end
