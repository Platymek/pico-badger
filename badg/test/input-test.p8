pico-8 cartridge // http://www.pico-8.com
version 42
__lua__

#include ../input.lua

r = {pos = {x = 64, y = 64}, w = 8, h = 8}
color = 8


down = {color = 3}

function down:trig()
    return btn(4) end
function down:deTrig()
    return not btn(4) end


pressed = {color = 10, down = false}

function pressed:trig()

    if not self.down and btn(4) 
    then
        self.down = true
        return true
    end
    if not btn(4) then
        self.down = false end
end


released = {color = 12, down = false}

function released:trig()

    if self.down and not btn(4) 
    then
        self.down = false
        return true 
    end
    if btn(4) then
        self.down = true end
end


held = {color = 11, tLimit = 0.2, t = 0}

function held:trig(p)

    if btn(4) then
        self.t += p.dt
    else
        self.t = 0
    end

    if self.t > self.tLimit then
        return true end
end

function held:deTrig()
    return not btn(4) end


input = Input{down, held, pressed, released}

function _update()

    input{dt=1/30}
end

function _draw()

    cls(1)
    rectfill(r.pos.x - r.w, r.pos.y - r.h, r.pos.x + r.w, r.pos.y + r.h, color)

    color = 8
    for _, inp in ipairs(input) do
        if input[inp] then color = inp.color or 7 end end
end

