pico-8 cartridge // http://www.pico-8.com
version 42
__lua__

#include ../rect.lua

local r1 = Rect{pos={ x = 32, y = 32 }, w=32, h=16}
local r2 = Rect{pos={ x = 64, y = 64 }, w=8, h=20}
local dt = 1/60
local speed = 32

function isSolid(r)

    if r:over{shape = r2} then
        return true 
    end
    
    for _, point in ipairs(r:pointsOverGrid{ gridSize = 8 }) do

        if fget(mget(point.x, point.y), 0) then
            return true
        end
    end

    return false
end

function _update60()

    local move = speed * dt
    if btn(0) then r1.pos.x -= move end
    if btn(1) then r1.pos.x += move end
    if btn(2) then r1.pos.y -= move end
    if btn(3) then r1.pos.y += move end
end

function _draw()

    cls(1)
    map(0, 0, 0, 0, 16, 16)

    r1:draw{col= isSolid(r1) and 8 or 11, fill=false}
    r2:draw{col=12, fill=true}

    local r3 = r1:off{x = 32, y = 32}
    r3:draw{col= isSolid(r3) and 8 or 11, fill=false}
end
